# Copy to .env and fill in:  cp .env.example .env   (Windows: copy .env.example .env)

# ---------------------------------------------------------------------------------------
# Which model the agents think with
# ---------------------------------------------------------------------------------------
#   pool   = several FREE cloud models used together, each within its own free-tier limits.
#            Fastest: a full conference (~60-75 accounts) in about 5 minutes with 4-5 keys below.
#   ollama = local model on your own GPU via Ollama (no API key, no quota, slower).
#   gemini = Google Gemini API alone (the free tier allows only ~20 calls/day).
ICP_LLM_PROVIDER=pool

# Model name for ollama/gemini. Blank = provider default: gemma4:12b (ollama) / gemini-3.8-flash (gemini).
# (The pool picks per provider - see ICP_<NAME>_MODEL below.)
# For ollama, download it first:  ollama pull gemma4:12b
ICP_LLM_MODEL=

# --- Model pool (ICP_LLM_PROVIDER=pool) -----------------------------------------------
# Add a key for every provider you can; only providers with a key are used. Each is free, no card needed.
# (GitHub Models was retired by GitHub on 30 July 2026, so it is no longer an option.)
# More keys = more combined requests/minute = faster. One key alone works, just slower.
GROQ_API_KEY=          # https://console.groq.com/keys          (~30 req/min, 1,000/day)
CEREBRAS_API_KEY=      # https://cloud.cerebras.ai               (very fast; 1M tokens/day)
MISTRAL_API_KEY=       # https://console.mistral.ai/api-keys     (free "Experiment" plan)
OPENROUTER_API_KEY=    # https://openrouter.ai/keys               (":free" models; ~50 req/day; picks a free model itself)
# GEMINI_API_KEY (below) is also used by the pool - and is the one that reads logo images.
# Ollama joins the pool automatically as a last-resort backup if it is in ICP_POOL and running.

# Order of preference; the pool still spreads work to whichever has capacity soonest.
ICP_POOL=groq,cerebras,mistral,openrouter,gemini,ollama

# Fast mode: triage all accounts in batches first (non-buyers skip research), one search per
# account, short answers. Blank = on for the pool, off for ollama/gemini. true | false
ICP_FAST=
# In fast mode, research and scoring of several accounts share one model call (each account still gets its own
# message to the next agent). Free tiers cap requests per minute, so this is the biggest speed-up. 1 = off.
ICP_BATCH=4
# Fast mode: how many top accounts (A-tier, 85+) get a full one-to-one Strategist conversation (a hook question to
# the Researcher, a possible challenge to the Analyst). Each costs 2-3 model calls; the rest are drafted in shared calls.
ICP_TALKS=8

# Per-provider overrides (optional). NAME = GROQ | CEREBRAS | MISTRAL | OPENROUTER | GEMINI | OLLAMA
#   ICP_<NAME>_MODEL        model id, e.g. ICP_GROQ_MODEL=llama-3.3-70b-versatile
#   ICP_<NAME>_RPM / _RPD   requests per minute / per day   (set to match your account's limits)
#   ICP_<NAME>_TPM / _TPD   tokens per minute / per day
#   ICP_<NAME>_CONCURRENCY  calls in flight at once
#   ICP_<NAME>_BASE_URL     OpenAI-compatible endpoint
#   ICP_<NAME>_MODELS       extra models of the same provider, comma-separated (each has its OWN free limits)
#   ICP_<NAME>_DISCOVER     false = don't add the provider's other models automatically (Groq, Cerebras)
# Free limits are per model, so for Groq and Cerebras the pool also adds up to 3 of the provider's other
# tool-capable models at start-up, and reads each model's real limits from the provider's reply headers.
# Defaults follow each provider's published free-tier limits; a paid tier -> raise them.

# --- Local model (ICP_LLM_PROVIDER=ollama) ---------------------------------------------
ICP_OLLAMA_URL=http://localhost:11434
# Context window in tokens. 16384 fits a 12 GB GPU with room to spare; raise for longer pages,
# lower (e.g. 8192) if Ollama reports running out of GPU memory.
ICP_OLLAMA_NUM_CTX=16384
# Let the model "think" before answering: better judgement, noticeably slower. true | false
ICP_OLLAMA_THINK=false
# Most tokens one reply may generate. Stops runaway answers (which are slow and get cut off).
ICP_OLLAMA_MAX_OUTPUT=2048

# Web research for the local model AND the pool runs on this machine:
#   ddgs       = default; rotates across Bing, Brave, DuckDuckGo, Google, Mojeek... (no key)
#   duckduckgo = DuckDuckGo only (blocks quickly under load)
#   searxng    = your own SearXNG instance: most reliable (set ICP_SEARXNG_URL, enable JSON output)
ICP_SEARCH_PROVIDER=ddgs
ICP_SEARXNG_URL=
# Searches run a few at a time (all agents share them); their start times are spaced this many seconds.
# If engines start refusing, raise the interval (e.g. 3) or lower the parallel count (e.g. 1).
ICP_SEARCH_INTERVAL=1
ICP_SEARCH_PARALLEL=3
# How much of each web page's text is handed to the model.
ICP_PAGE_CHARS=8000

# --- Gemini (ICP_LLM_PROVIDER=gemini, or as one member of the pool) --------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---------------------------------------------------------------------------------------
# The run
# ---------------------------------------------------------------------------------------
# Conference to qualify.
ICP_EVENT_URL=https://fieldserviceusa.wbresearch.com/

# OPTIONAL. The company whose ideal customer profile you qualify prospects against.
# With a URL, the Researcher reads that site live at start-up and briefs the team.
# Leave both blank to use the built-in profile of a field-service AI vendor.
ICP_VENDOR_NAME=
ICP_VENDOR_URL=

# How the Scout gets live data. There is no saved-data mode.
#   live  = fetch from this machine; with Gemini, if the site blocks this machine, Gemini reads it instead
#   local = fetch from this machine only; stop if the site can't be reached
ICP_SCRAPE_MODE=live

# 0 = every account found. Use e.g. 10 for a quick demo run.
ICP_MAX_ACCOUNTS=0

# Accounts researched in parallel. Blank/0 = provider default (pool 12, ollama 2, gemini 4).
ICP_CONCURRENCY=
# Web searches per account (a hard cap for the local model; a guideline for Gemini).
ICP_SEARCHES_PER_ACCOUNT=4

# Render JavaScript-built pages with Playwright if installed: auto | off
ICP_RENDER_JS=auto

# Where the workbook, transcript, JSON, live capture and run logs (output/logs/) are written.
ICP_OUTPUT_DIR=output

# ---------------------------------------------------------------------------------------
# Watching the run
# ---------------------------------------------------------------------------------------
# Seconds before a model call is treated as stuck and retried. Blank/0 = provider default
# (pool 45 per cloud model, ollama 300, gemini 180).
ICP_LLM_TIMEOUT=

# Seconds between status reports on the console (0 = off). Each report shows every model call
# in flight and what each agent is doing, so a slow run never looks frozen.
ICP_HEARTBEAT=15

# Console log level: DEBUG | INFO | WARNING | ERROR. The log file always records DEBUG.
ICP_LOG_LEVEL=INFO
